# App
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=changeme-app-secret
APP_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/ihg_platform
DATABASE_HOST=db
DATABASE_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ihg_platform

# JWT
JWT_SECRET_KEY=changeme-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=5

# Email (SMTP) — DEV uses Mailpit, PROD uses real provider (Gmail/SendGrid/SES)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ihg-platform.com
SMTP_USE_TLS=false
# No dev/prod code branch — email_service.py always sends via real SMTP;
# only these .env values change per environment.

# Celery / Redis
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
AUTH_RATE_LIMIT_PER_MINUTE=5

# Idempotency
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# Company branding config path (usually left as default)
COMPANY_CONFIG_PATH=config/company.yaml

# PAYMENTS_WEBHOOK_SECRET key
PAYMENTS_WEBHOOK_SECRET=
# set a real value before any shared/staging deployment
# — it currently falls back to the checked-in default,
# which is fine for local dev only.